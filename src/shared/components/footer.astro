---
import FooterAbout from "@components/footer/footer-about.astro"
import FooterContact from "@components/footer/footer-contact.astro"
import FooterLegal from "@components/footer/footer-legal.astro"
import FooterLinks from "@components/footer/footer-links.astro"
import { ArrowRight, ShieldCheck } from "@lucide/astro"
import { useTranslations } from "@utils/i18n"
import { ROUTES } from "@utils/routes"

const t = useTranslations()
const year = new Date().getFullYear()
---

<footer class="to-neutral-dark bg-linear-to-b from-gray-900 text-gray-300">
	<!-- CTA Banner -->
	<div class="bg-primary/10 border-b border-gray-800">
		<div class="container mx-auto px-6 py-8">
			<div class="flex flex-col items-center justify-between gap-4 md:flex-row">
				<div class="text-center md:text-left">
					<h3 class="text-xl font-bold text-white">{t("footer.cta.title")}</h3>
					<p class="text-gray-400">{t("footer.cta.subtitle")}</p>
				</div>
				<a
					href={ROUTES.CONTACT}
					class="bg-primary hover:bg-primary-light inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold text-white shadow-lg transition hover:-translate-y-0.5"
				>
					<span>{t("footer.cta.button")}</span>
					<ArrowRight class="h-5 w-5" />
				</a>
			</div>
		</div>
	</div>

	<!-- Main Footer Content -->
	<div class="container mx-auto px-6 py-16">
		<div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
			<FooterAbout />
			<FooterLinks />
			<FooterLegal />
			<FooterContact />
		</div>
	</div>

	<!-- Bottom Bar -->
	<div class="border-t border-gray-800 bg-black/20">
		<div class="container mx-auto flex flex-col items-center justify-between gap-4 px-6 py-6 md:flex-row">
			<p class="text-sm text-gray-500">
				&copy; {year}
				<span class="text-gray-400">{t("footer.company.name")}</span> - {t("footer.rights")}
			</p>
			<div class="flex items-center gap-6 text-sm text-gray-500">
				<span class="flex items-center gap-2">
					<ShieldCheck class="text-primary h-4 w-4" />
					CIF: B70664057
				</span>
			</div>
		</div>
	</div>
</footer>
