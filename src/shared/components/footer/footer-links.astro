---
import { ROUTES } from "@utils/routes"
import { Zap } from "@lucide/astro"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()

const services = [
	{ name: t("services.1.title"), href: ROUTES.SERVICES },
	{ name: t("services.2.title"), href: ROUTES.SERVICES },
	{ name: t("services.3.title"), href: ROUTES.SERVICES },
	{ name: t("services.4.title"), href: ROUTES.SERVICES },
]
---

<div class="lg:col-span-1">
	<h3 class="mb-6 flex items-center gap-2 text-lg font-bold text-white">
		<Zap class="text-primary h-5 w-5" />
		Servicios
	</h3>
	<ul class="space-y-3">
		{
			services.map(service => (
				<li>
					<a
						href={service.href}
						class="group flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
					>
						<span class="bg-primary h-1.5 w-1.5 rounded-full transition group-hover:scale-125" />
						{service.name}
					</a>
				</li>
			))
		}
	</ul>
</div>
