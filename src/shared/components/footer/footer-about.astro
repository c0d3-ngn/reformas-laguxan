---
import { ASSETS } from "@utils/assets"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<div class="lg:col-span-1">
	<a href="/" class="mb-6 inline-flex items-center gap-3">
		<img src={ASSETS.LOGOS.MONOGRAM} alt={t("footer.logo.alt")} class="h-10 w-auto" loading="lazy" />
		<span class="text-xl font-bold text-white">{t("brand.name")}</span>
	</a>

	<p class="mb-6 text-sm leading-relaxed text-gray-400">
		{t("footer.about")}
	</p>

	<!-- Social Links -->
	<div class="flex gap-3">
		<a
			target="_blank"
			href="https://www.facebook.com/people/Reformas-y-Construcciones-Laguxan-SL/100047069718722"
			class="hover:bg-primary flex h-10 w-10 items-center justify-center rounded-lg bg-gray-800 text-gray-400 transition hover:text-white"
			aria-label={t("footer.social.facebook")}
		>
			<!-- Facebook icon from Lucide doesn't exist, keeping SVG -->
			<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
				<path
					d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
				></path>
			</svg>
		</a>
	</div>
</div>
