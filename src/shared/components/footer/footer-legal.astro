---
import { ROUTES } from "@utils/routes"
import { FileText } from "@lucide/astro"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()

const legalLinks = [
	{ name: t("footer.links.legal"), href: ROUTES.LEGAL },
	{ name: t("footer.links.privacy"), href: ROUTES.PRIVACY },
	{ name: t("terms.title"), href: ROUTES.TERMS },
]

const { name, class: className = "h-5 w-5" } = Astro.props
---

<div class="lg:col-span-1">
	<h3 class="mb-6 flex items-center gap-2 text-lg font-bold text-white">
		<FileText class="text-primary h-5 w-5" />
		{t("footer.title.legal")}
	</h3>
	<ul class="space-y-3">
		{
			legalLinks.map(link => (
				<li>
					<a href={link.href} class="group flex items-center gap-2 text-sm text-gray-400 transition hover:text-white">
						<span class="bg-primary h-1.5 w-1.5 rounded-full transition group-hover:scale-125" />
						{link.name}
					</a>
				</li>
			))
		}
	</ul>
</div>
