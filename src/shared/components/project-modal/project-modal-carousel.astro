---
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<div class="group relative mb-6 h-64 w-full overflow-hidden rounded-lg bg-gray-200 md:h-96" x-data="carouselData()">
	<template x-for="(img, index) in $parent.activeProject?.images" :key="index">
		<img
			:src="img"
			:alt="($parent.activeProject?.title || '') + ' ' + (index + 1)"
			x-show="currentImage === index"
			x-transition:enter="transition ease-in duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			class="absolute inset-0 h-full w-full object-cover"
		/>
	</template>

	<!-- Carousel Controls -->
	<button
		class="absolute top-1/2 left-2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white opacity-0 transition group-hover:opacity-100 hover:bg-black/70"
		@click="prev($parent.activeProject?.images?.length || 0)"
		x-show="$parent.activeProject?.images?.length > 1"
		aria-label={t("modal.prev.aria")}>←</button
	>
	<button
		class="absolute top-1/2 right-2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white opacity-0 transition group-hover:opacity-100 hover:bg-black/70"
		@click="next($parent.activeProject?.images?.length || 0)"
		x-show="$parent.activeProject?.images?.length > 1"
		aria-label={t("modal.next.aria")}></button>
</div>
