---
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<dialog id="project-modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box flex max-h-[90vh] max-w-4xl flex-col overflow-hidden bg-white text-gray-900">
    <div class="relative shrink-0">
      <div id="carousel-container" class="carousel carousel-center h-64 w-full shrink-0 gap-4 bg-gray-200 md:h-80">
        <div id="carousel-images" class="carousel-item h-full w-full">
          <img class="h-full w-full rounded-lg bg-gray-200 object-contain" />
        </div>
      </div>

      <button
        id="carousel-prev"
        class="btn btn-circle btn-sm absolute top-1/2 left-2 z-10 hidden -translate-y-1/2 bg-black/50 text-white hover:bg-black/70 md:flex [&_svg]:mx-auto"
        aria-label={t("modal.prev.aria")}
      >
        <ChevronLeft size={24} />
      </button>
      <button
        id="carousel-next"
        class="btn btn-circle btn-sm absolute top-1/2 right-2 z-10 hidden -translate-y-1/2 bg-black/50 text-white hover:bg-black/70 md:flex [&_svg]:mx-auto"
        aria-label={t("modal.next.aria")}
      >
        <ChevronRight size={24} />
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto py-4" style="max-height: 40vh;">
      <h3 id="modal-title" class="text-2xl font-bold text-gray-900"></h3>
      <div class="mt-2 mb-4 flex items-center gap-4 text-sm text-gray-500">
        <span id="modal-location"></span>
        <span>-</span>
        <span id="modal-year"></span>
      </div>
      <p id="modal-description" class="text-gray-600"></p>
    </div>

    <div class="modal-action mt-4">
      <form method="dialog">
        <button class="btn btn-neutral">{t("modal.close")}</button>
      </form>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop bg-black/70 backdrop-blur-sm">
    <button>close</button>
  </form>
</dialog>
