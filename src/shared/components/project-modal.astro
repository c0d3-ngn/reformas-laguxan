---
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<div
	id="project-modal"
	class="fixed inset-0 z-50 hidden overflow-y-auto"
	aria-labelledby="modal-title"
	role="dialog"
	aria-modal="true"
>
	<div id="modal-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm transition-opacity"></div>

	<div class="flex min-h-screen items-center justify-center p-4 text-center sm:p-0">
		<div
			class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-4xl"
		>
			<!-- Close button -->
			<div class="absolute top-0 right-0 z-10 hidden pt-4 pr-4 sm:block">
				<button
					id="modal-close-btn"
					type="button"
					class="focus:ring-primary rounded-md bg-white text-gray-400 hover:text-gray-500 focus:ring-2 focus:ring-offset-2 focus:outline-none"
				>
					<span class="sr-only">{t("modal.close")}</span>
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<div class="px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
				<div class="flex-col sm:flex sm:items-start">
					<!-- Carousel -->
					<div class="group relative mb-6 h-64 w-full overflow-hidden rounded-lg bg-gray-200 md:h-96">
						<div id="carousel-images" class="relative h-full w-full">
							<!-- Images injected via JS -->
						</div>

						<!-- Carousel Controls -->
						<button
							id="carousel-prev"
							class="absolute top-1/2 left-2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white transition hover:bg-black/70 cursor-pointer"
							aria-label={t("modal.prev.aria")}
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M15 18l-6-6 6-6"/>
							</svg>
						</button>
						<button
							id="carousel-next"
							class="absolute top-1/2 right-2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white transition hover:bg-black/70 cursor-pointer"
							aria-label={t("modal.next.aria")}
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M9 18l6-6-6-6"/>
							</svg>
						</button>
					</div>

					<!-- Content -->
					<div class="w-full">
						<h3 id="modal-title" class="mb-2 text-2xl leading-6 font-semibold text-gray-900"></h3>
						<div class="mb-4 flex items-center gap-4 text-sm text-gray-500">
							<span id="modal-location"></span>
							<span>•</span>
							<span id="modal-year"></span>
						</div>
						<div class="mt-2">
							<p id="modal-description" class="text-gray-600"></p>
						</div>
					</div>
				</div>
			</div>

			<div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
				<button
					id="modal-close"
					type="button"
					class="bg-neutral-dark inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-black sm:ml-3 sm:w-auto"
				>
					{t("modal.close")}
				</button>
			</div>
		</div>
	</div>
</div>
