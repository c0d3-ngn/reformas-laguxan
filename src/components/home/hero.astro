---
import { ASSETS } from "@utils/assets"
import { useTranslations } from "@utils/i18n"
import { ROUTES } from "@utils/routes"

const t = useTranslations()
---

<div
  class="hero min-h-[calc(100vh-4rem)] bg-cover bg-center bg-no-repeat"
  style={`background-image: url('${ASSETS.HOME.HERO}')`}
>
  <div class="hero-overlay bg-neutral-dark/70"></div>
  <div class="hero-content text-center text-white">
    <div class="mx-auto max-w-4xl">
      <h1 class="mb-6 text-4xl font-bold tracking-tight md:text-6xl">
        {t("hero.title.part1")}
        <span class="text-blue-400">{t("hero.title.part2")}</span>
        {t("hero.title.part3")}
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-gray-200 md:text-xl">
        {t("hero.subtitle")}
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a href={ROUTES.CONTACT} class="btn btn-primary shadow-lg">{t("hero.cta.primary")}</a>
        <a href={ROUTES.PROJECTS} class="btn btn-ghost text-neutral-dark bg-white shadow-lg hover:bg-gray-100"
          >{t("hero.cta.secondary")}</a
        >
      </div>
    </div>
  </div>
</div>
