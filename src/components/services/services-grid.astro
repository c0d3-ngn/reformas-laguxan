---
import { Bath, BrickWall, Building2, House, PaintBucket, Ruler } from "@lucide/astro"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()

const services = [
	{ id: 1, icon: House },
	{ id: 2, icon: Building2 },
	{ id: 3, icon: Bath },
	{ id: 4, icon: BrickWall },
	{ id: 5, icon: PaintBucket },
	{ id: 6, icon: Ruler },
]
---

<div class="bg-neutral-light py-16">
	<div class="animate-in fade-in slide-in-from-bottom-4 container mx-auto px-6 text-center duration-700">
		<h1 class="text-neutral-dark mb-4 text-4xl font-bold">
			{t("services.title")}
		</h1>
		<p class="mx-auto max-w-2xl text-gray-600">
			{t("services.subtitle")}
		</p>
	</div>
</div>

<section class="container mx-auto px-6 py-20">
	<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
		{
			services.map((service, index) => (
				<div
					class="group animate-in fade-in slide-in-from-bottom-8 fill-mode-both rounded-lg border border-gray-100 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
					style={`animation-delay: ${index * 100}ms`}
				>
					<div class="mb-4 flex justify-center transition-transform duration-300 group-hover:scale-110">
						<service.icon class="text-primary h-12 w-12" />
					</div>
					<h3 class="text-neutral-dark mb-3 text-xl font-bold">{t(`services.${service.id}.title`)}</h3>
					<p class="leading-relaxed text-gray-600">{t(`services.${service.id}.desc`)}</p>
				</div>
			))
		}
	</div>
</section>
