---
import { services } from "@data/services"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<div class="bg-neutral-light py-16">
  <div class="animate-in fade-in slide-in-from-bottom-4 container mx-auto px-6 text-center duration-700">
    <h1 class="text-neutral-dark mb-4 text-4xl font-bold">
      {t("services.title")}
    </h1>
    <p class="mx-auto max-w-2xl text-gray-600">
      {t("services.subtitle")}
    </p>
  </div>
</div>

<section class="container mx-auto px-6 py-20">
  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service, index) => (
        <div
          class="card group animate-in fade-in slide-in-from-bottom-8 fill-mode-both bg-white shadow-sm transition-all duration-300 hover:shadow-xl"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="card-body items-center text-center">
            <div class="mb-4 flex justify-center transition-transform duration-300 group-hover:scale-110">
              <service.icon class="text-primary h-12 w-12" />
            </div>
            <h3 class="card-title justify-center text-xl font-bold text-gray-900">
              {t(`services.${service.id}.title`)}
            </h3>
            <p class="leading-relaxed text-gray-600">{t(`services.${service.id}.desc`)}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
