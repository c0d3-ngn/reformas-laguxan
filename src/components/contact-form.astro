---
import translations from '@locales/es.json';
import UiButton from './ui-button.astro';

const t = translations.contact;
---

<form action="[YOUR_FORMSPREE_ENDPOINT]" method="POST" class="space-y-6" id="contact-form">
  <!-- Name Field -->
  <div>
    <label for="name" class="block text-sm font-semibold text-neutral-dark mb-2">
      {t.form.name}
      <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="input-field"
      placeholder="Juan Pérez"
    />
  </div>

  <!-- Email Field -->
  <div>
    <label for="email" class="block text-sm font-semibold text-neutral-dark mb-2">
      {t.form.email}
      <span class="text-red-500">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="input-field"
      placeholder="juan@ejemplo.com"
    />
  </div>

  <!-- Phone Field -->
  <div>
    <label for="phone" class="block text-sm font-semibold text-neutral-dark mb-2">
      {t.form.phone}
    </label>
    <input type="tel" id="phone" name="phone" class="input-field" placeholder="+34 XXX XXX XXX" />
  </div>

  <!-- Message Field -->
  <div>
    <label for="message" class="block text-sm font-semibold text-neutral-dark mb-2">
      {t.form.message}
      <span class="text-red-500">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      class="input-field resize-y"
      placeholder="Cuéntanos qué necesitas..."></textarea>
  </div>

  <!-- Submit Button -->
  <UiButton variant="primary" type="submit" class="w-full text-lg">
    {t.form.submit}
  </UiButton>

  <!-- Form Messages -->
  <div id="form-message" class="hidden p-4 rounded-lg text-center font-medium"></div>
</form>

<script>
  import '@scripts/contact';
</script>
