---
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<div
	class="animate-in fade-in zoom-in-95 slide-in-from-bottom-8 mx-auto grid max-w-5xl overflow-hidden rounded-2xl bg-white shadow-xl duration-500 md:grid-cols-2"
>
	<div class="bg-primary flex flex-col justify-between p-12 text-white">
		<div>
			<h2 class="mb-6 text-3xl font-bold">
				{t("contact.title")}
			</h2>
			<p class="mb-8 text-blue-100">
				{t("contact.subtitle")}
			</p>
		</div>

		<div class="mt-12">
			<p class="text-xs text-blue-200">
				{t("contact.schedule")}
			</p>
		</div>
	</div>

	<div class="p-6 md:p-12">
		<form action="https://formspree.io/f/xykdklaq" method="POST" class="space-y-6">
			<div>
				<label for="name" class="mb-1 block text-sm font-medium text-gray-700">{t("contact.form.name")}</label>
				<input
					type="text"
					id="name"
					name="name"
					required
					class="focus:ring-primary focus:border-primary w-full rounded-md border border-gray-300 px-4 py-2 transition outline-none focus:ring-2"
					placeholder={t("contact.form.name.placeholder")}
				/>
			</div>

			<div>
				<label for="email" class="mb-1 block text-sm font-medium text-gray-700">{t("contact.form.email")}</label>
				<input
					type="email"
					id="email"
					name="email"
					required
					class="focus:ring-primary focus:border-primary w-full rounded-md border border-gray-300 px-4 py-2 transition outline-none focus:ring-2"
					placeholder={t("contact.form.email.placeholder")}
				/>
			</div>

			<div>
				<label for="message" class="mb-1 block text-sm font-medium text-gray-700">{t("contact.form.message")}</label>
				<textarea
					id="message"
					name="message"
					rows="4"
					required
					class="focus:ring-primary focus:border-primary w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-900 transition outline-none placeholder:text-gray-500 focus:ring-2"
					placeholder={t("contact.form.message.placeholder")}></textarea>
			</div>

			<div class="flex items-center gap-2">
				<input type="checkbox" id="privacy" required class="text-primary focus:ring-primary rounded" />
				<label for="privacy" class="text-xs text-gray-500">{t("contact.form.privacy")}</label>
			</div>

			<button
				type="submit"
				class="bg-neutral-dark w-full transform rounded-md py-3 font-bold text-white transition hover:scale-105 hover:bg-black active:scale-95"
			>
				{t("contact.form.submit")}
			</button>
		</form>
	</div>
</div>
