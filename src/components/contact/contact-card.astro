---
import { ASSETS } from "@utils/assets"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<div
  class="animate-in fade-in zoom-in-95 slide-in-from-bottom-8 mx-auto grid max-w-5xl overflow-hidden rounded-2xl bg-white shadow-xl duration-500 md:grid-cols-2"
>
  <div class="bg-primary flex flex-col justify-between p-12 text-white">
    <div>
      <h2 class="mb-6 text-3xl font-bold">
        {t("contact.title")}
      </h2>
      <p class="mb-8 text-blue-100">
        {t("contact.subtitle")}
      </p>
    </div>

    <div class="mt-12">
      <p class="text-xs text-blue-200">
        {t("contact.schedule")}
      </p>
    </div>
  </div>

  <div class="p-6 md:p-12">
    <form action={ASSETS.FORMSPREE_ENDPOINT} method="POST" class="space-y-6">
      <div class="form-control">
        <label for="name" class="label">
          <span class="label-text">{t("contact.form.name")}</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="input input-bordered focus:ring-primary focus:border-primary w-full"
          placeholder={t("contact.form.name.placeholder")}
        />
      </div>

      <div class="form-control">
        <label for="email" class="label">
          <span class="label-text">{t("contact.form.email")}</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="input input-bordered focus:ring-primary focus:border-primary w-full"
          placeholder={t("contact.form.email.placeholder")}
        />
      </div>

      <div class="form-control">
        <label for="message" class="label">
          <span class="label-text">{t("contact.form.message")}</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="textarea textarea-bordered focus:ring-primary w-full"
          placeholder={t("contact.form.message.placeholder")}></textarea>
      </div>

      <div class="form-control">
        <label class="label cursor-pointer justify-start gap-3">
          <input type="checkbox" id="privacy" required class="checkbox checkbox-primary" />
          <span class="label-text text-xs text-gray-500">{t("contact.form.privacy")}</span>
        </label>
      </div>

      <button type="submit" class="btn btn-neutral w-full">
        {t("contact.form.submit")}
      </button>
    </form>
  </div>
</div>
