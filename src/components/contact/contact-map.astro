---
import { ASSETS } from "@utils/assets"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<section class="h-96 w-full bg-gray-200">
	<iframe
		width="100%"
		height="100%"
		style="border:0"
		loading="lazy"
		allowfullscreen
		title={t("contact.map.title")}
		src={ASSETS.CONTACT.MAP}
	>
	</iframe>
</section>
