---
import { MapPin } from '@lucide/astro';

interface Props {
  id: number;
  title: string;
  date: string;
  location: string;
  description: string;
}

const { id, title, date, location, description } = Astro.props;
---

<div class="card group overflow-hidden cursor-pointer" data-project-id={id}>
  <!-- Project Image -->
  <div class="relative -mx-6 -mt-6 mb-6 h-48 overflow-hidden">
    <img
      src={`/projects/project-${id}.jpg`}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>

    <!-- Labels -->
    <div class="absolute top-4 right-4 flex gap-2">
      <span class="bg-accent text-white px-3 py-1 rounded-full text-sm font-semibold">
        {date}
      </span>
    </div>

    <div class="absolute bottom-4 left-4">
      <div class="flex items-center gap-2 text-white">
        <MapPin class="w-4 h-4" />
        <span class="text-sm font-medium">{location}</span>
      </div>
    </div>

    <!-- Click to view indicator -->
    <div
      class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/30"
    >
      <div class="bg-white text-primary px-4 py-2 rounded-lg font-semibold">Ver Detalles</div>
    </div>
  </div>

  <!-- Content -->
  <h3 class="text-xl font-bold text-neutral-dark mb-3 line-clamp-2">{title}</h3>
  <p class="text-secondary leading-relaxed">{description}</p>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
