---
import ProjectModal from "@components/project-modal.astro"
import Layout from "@layouts/Layout.astro"
import { useTranslations } from "@utils/i18n"
import { projects } from "@data/projects"

const t = useTranslations()

const PER_PAGE = 6
---

<Layout title={t("projects.title")}>
  <div class="container mx-auto px-6 pt-12 pb-20">
    <h1
      class="text-neutral-dark animate-in fade-in slide-in-from-bottom-4 mb-12 text-center text-4xl font-bold duration-700"
    >
      {t("projects.title")}
    </h1>

    <div id="projects-grid" class="grid gap-10 md:grid-cols-2 lg:grid-cols-3" data-projects={JSON.stringify(projects)}>
      {
        projects.slice(0, PER_PAGE).map((project, index) => (
          <article
            class="project-card group animate-in fade-in slide-in-from-bottom-8 fill-mode-both relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
            style={`animation-delay: ${index * 100}ms`}
            data-project={JSON.stringify(project)}
          >
            <figure class="h-80 w-full overflow-hidden">
              <img
                src={project.images[0]}
                alt={project.title}
                class="h-full w-full object-cover transition duration-700 group-hover:scale-110"
                loading="lazy"
              />
            </figure>
            <div class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/90 via-black/50 to-transparent p-6 text-white">
              <span class="badge bg-primary mb-3 translate-y-2 border-none text-white opacity-0 shadow-lg transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                {project.location}
              </span>
              <h3 class="text-xl font-bold">{project.title}</h3>
            </div>
          </article>
        ))
      }
    </div>

    <div id="load-more-container" class="mt-8 flex justify-center">
      {
        projects.length > PER_PAGE && (
          <button
            id="load-more-btn"
            data-page="1"
            data-per-page={PER_PAGE}
            data-total={projects.length}
            class="btn btn-primary shadow-lg"
          >
            {t("projects.load_more")}
          </button>
        )
      }
    </div>

    <div id="loading-spinner" class="mt-8 hidden h-20 w-full items-center justify-center">
      <span class="loading loading-spinner loading-lg text-primary"></span>
    </div>

    <ProjectModal />
  </div>

  <script>
    import "@scripts/projects"
  </script>
</Layout>
