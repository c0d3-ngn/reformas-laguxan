---
import LegalContent from "@components/legal-content.astro"
import Layout from "@layouts/Layout.astro"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
const sections = [1, 2, 3, 4, 5]
---

<Layout title={t("legal.title")}>
  <LegalContent
    title={t("legal.title")}
    intro={t("legal.intro")}
    sections={sections}
    translationKey="legal"
    lastUpdate={t("legal.last_update")}
  />
</Layout>
