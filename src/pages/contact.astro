---
import ContactCard from "@components/contact/contact-card.astro"
import ContactMap from "@components/contact/contact-map.astro"
import Layout from "@layouts/Layout.astro"
import { useTranslations } from "@utils/i18n"

const t = useTranslations()
---

<Layout title={t("nav.contact")}>
  <section class="bg-neutral-light/30 py-20">
    <div class="container mx-auto px-6">
      <ContactCard />
    </div>
  </section>

  <ContactMap />
</Layout>
