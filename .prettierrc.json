{
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"htmlWhitespaceSensitivity": "css",
	"insertPragma": false,
	"requirePragma": false,
	"printWidth": 120,
	"proseWrap": "always",
	"quoteProps": "as-needed",
	"semi": false,
	"singleQuote": false,
	"tabWidth": 2,
	"useTabs": true,
	"trailingComma": "all",
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		}
	]
}
